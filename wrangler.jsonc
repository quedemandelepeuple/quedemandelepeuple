{
  "main": "dist/_worker.js/index.js",
  "name": "quedemandelepeuple",
  "compatibility_date": "2025-12-04",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
  },
  "observability": {
    "enabled": true,
  },
  "routes": [
    {
      "pattern": "quedemandelepeuple.fr/*",
      "zone_name": "quedemandelepeuple.fr",
    },
  ],
}
