---
import "../styles/global.css";
import Footer from "../components/Footer.astro";

const structuredData = {
    "@context": "https://schema.org",
    "@graph": [
        {
            "@type": "WebSite",
            "@id": "https://quedemandelepeuple.fr/",
            name: "Que Demande le Peuple ?",
            description:
                "Une série de podcasts qui fait entendre la parole des oublié·es, entre colère et solidarité. Soutenez la voix populaire !",
            url: "https://quedemandelepeuple.fr/",
            publisher: [
                {
                    "@type": "Person",
                    name: "Pauline Maucort",
                    url: "https://www.radiofrance.fr/personnes/pauline-maucort",
                },
                {
                    "@type": "Person",
                    name: "Rémi Dybowski Douat",
                    url: "https://www.radiofrance.fr/personnes/remi-dybowski-douat",
                },
            ],
        },
    ],
};
---

<!doctype html>
<html data-theme="bumblebee" lang="fr">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <link rel="sitemap" href="/sitemap-index.xml" />
        <link rel="icon" type="image/svg+xml" href="/public/megaphone.svg" />
        {
            structuredData && (
                <script
                    is:inline
                    type="application/ld+json"
                    set:html={JSON.stringify(structuredData)}
                />
            )
        }
        <title>"Que demande le peuple"</title>
    </head>
    <body>
        <slot />
        <Footer />
    </body>
</html>

<style>
    html,
    body {
        margin: 0;
        width: 100%;
        height: 100%;
    }
</style>
