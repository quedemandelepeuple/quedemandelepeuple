---
const currentYear = new Date().getFullYear();
---

<footer class="bg-accent text-neutral-content mt-auto">
  <div class="max-w-6xl mx-auto px-6 py-8">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 items-center">
      
      <!-- Brand Section -->
      <div class="flex flex-col items-center md:items-start gap-3">
        <svg 
          xmlns="http://www.w3.org/2000/svg" 
          width="48" 
          height="48" 
          viewBox="0 0 64 64" 
          fill="white"
          aria-hidden="true"
          class="transition-transform hover:scale-110"
        >
          <path d="M20 50.45a1 1 0 0 1-.71-.3l-5.65-5.65a1 1 0 0 1 0-1.42l21.22-21.21a1 1 0 0 1 1.41 0l5.66 5.66a1 1 0 0 1 .29.7 1 1 0 0 1-.29.71L20.72 50.15a1 1 0 0 1-.72.3m-4.24-6.66L20 48l19.8-19.8-4.24-4.2Z"/>
          <path d="M45.46 29.33a11 11 0 1 1 7.78-3.22 10.94 10.94 0 0 1-7.78 3.22m0-20a9 9 0 1 0 6.37 15.37 9 9 0 0 0-6.37-15.36Z"/>
          <path d="M35.56 34.89a1 1 0 0 1-.7-.29l-5.66-5.66a1 1 0 0 1 0-1.41l5.66-5.66a1 1 0 0 1 1.41 0l5.66 5.66a1 1 0 0 1 .29.7 1 1 0 0 1-.29.71l-5.66 5.66a1 1 0 0 1-.71.29m-4.24-6.66 4.24 4.25 4.25-4.25L35.56 24ZM16.12 50.8a1 1 0 0 1-.71-.29l-2.12-2.12a1 1 0 0 1 0-1.42l2.12-2.12a1 1 0 0 1 1.42 0L19 47a1 1 0 0 1 0 1.42l-2.12 2.12a1 1 0 0 1-.76.26m-.71-3.12.71.71.71-.71-.71-.68Z"/>
          <path d="M17.45 56.86a2.65 2.65 0 0 1-1.81-.7c-2-1.79-1.66-6.57-1.58-7.51a1 1 0 0 1 1.09-.91 1 1 0 0 1 .9 1.09c-.17 1.93 0 5 .93 5.85a.73.73 0 0 0 .71.15c3.3-.66 7.38-3.36 7.42-3.39 1-.78 4.73-3.39 6.68-2.78A1.82 1.82 0 0 1 33 49.84a1 1 0 0 1-1.87.71c-.68-.06-2.93 1.09-4.85 2.53-.22.15-4.49 3-8.18 3.71a3.5 3.5 0 0 1-.65.07"/>
        </svg>
        
        <p class="text-lg opacity-80">
          {currentYear} — <span class="font-semibold text-lg text-center md:text-left">
            QUE DEMANDE LE PEUPLE !
            <span/>
        </p>
      </div>

      <!-- Navigation Links -->
      <nav class="flex flex-col md:flex-row items-center justify-center gap-4 text-center" aria-label="Navigation footer">
        <a 
          href="/" 
          class="hover:underline hover:text-white transition-colors font-medium"
          aria-label="Retour à l'accueil"
        >
          Accueil
        </a>
        <span class="hidden md:inline opacity-50" aria-hidden="true">|</span>
        <a 
          href="/mentions-legales" 
          class="hover:underline hover:text-white transition-colors font-medium"
        >
          Mentions légales
        </a>
      </nav>

      <!-- Social Links -->
      <nav class="flex items-center justify-center md:justify-end gap-6" aria-label="Réseaux sociaux">
        <a 
          href="https://fr.ulule.com/que-demande-le-peuple--/" 
          rel="noopener noreferrer" 
          target="_blank"
          class="group transition-transform hover:scale-110"
          aria-label="Soutenez-nous sur Ulule (ouvre dans un nouvel onglet)"
        >
          <svg 
            class="fill-current group-hover:opacity-80 transition-opacity" 
            width="32" 
            height="32" 
            viewBox="0 0 24 24" 
            role="img" 
            xmlns="http://www.w3.org/2000/svg"
            aria-hidden="true"
          >
            <title>Ulule</title>
